{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "lib": ["ES2020", "DOM", "DOM.Iterable"],
  "typeRoots": ["./node_modules/phaser/types"],
  "types": ["Phaser"]
}
